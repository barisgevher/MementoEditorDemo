@page "/"
@using MementoEditorDemo.Services
@using MementoEditorDemo.Models
@inject EditorService EditorService

<PageTitle>Memento Editor</PageTitle>

<div class="me-root">

  <!-- ══ HEADER ══════════════════════════════════════════════════ -->
  <div class="me-header">
    <div class="me-title-block">
      <span class="me-logo">&#9672;</span>
      <div>
        <h1 class="me-title">Memento Editor</h1>
        <p class="me-sub">Her tuş vuruşu bir Memento — Originator · Caretaker · Snapshot</p>
      </div>
    </div>

    <div class="me-mode-group">
      <button class="me-mode-btn @(EditorService.Mode == SaveMode.Snapshot ? "active" : "")"
              @onclick="() => SetMode(SaveMode.Snapshot)">
        Snapshot
      </button>
      <button class="me-mode-btn @(EditorService.Mode == SaveMode.Delta ? "active" : "")"
              @onclick="() => SetMode(SaveMode.Delta)">
        Delta
      </button>
    </div>
  </div>

  <!-- ══ ANA GRID ═════════════════════════════════════════════════ -->
  <div class="me-grid">

    <!-- ── SOL: Editör ─────────────────────────────────────────── -->
    <div class="me-card me-editor-panel">
      <div class="me-card-header">
        <span class="me-card-title">Metin Editörü</span>
        <span class="me-badge @(EditorService.Mode == SaveMode.Snapshot ? "badge-blue" : "badge-green")">
          @EditorService.Mode mod
        </span>
      </div>

      <textarea class="me-textarea"
                placeholder="Yazmaya başlayın…"
                value="@_content"
                @oninput="HandleInput"
                rows="12"></textarea>

      <div class="me-toolbar">
        <button class="me-btn btn-undo" @onclick="Undo"
                disabled="@(!EditorService.CanUndo)">
          &#8617; Geri Al (@EditorService.UndoCount)
        </button>
        <button class="me-btn btn-redo" @onclick="Redo"
                disabled="@(!EditorService.CanRedo)">
          İleri Al (@EditorService.RedoCount) &#8618;
        </button>
        <button class="me-btn btn-clear ms-auto" @onclick="Clear">
          Temizle
        </button>
      </div>

      <div class="me-mem-bar">
        <div class="me-mem-item">
          <span class="me-mem-label">Snapshot toplam</span>
          <span class="me-mem-val blue">@FormatBytes(EditorService.TotalSnapshotBytes)</span>
        </div>
        <div class="me-mem-divider"></div>
        <div class="me-mem-item">
          <span class="me-mem-label">Delta toplam</span>
          <span class="me-mem-val green">@FormatBytes(EditorService.TotalDeltaBytes)</span>
        </div>
        <div class="me-mem-divider"></div>
        <div class="me-mem-item">
          <span class="me-mem-label">Tasarruf</span>
          <span class="me-mem-val @(Savings > 0 ? "amber" : "muted")">
            @(Savings > 0 ? $"% {Savings:F0}" : "—")
          </span>
        </div>
      </div>
    </div>

    <!-- ── ORTA: Caretaker Stack ────────────────────────────────── -->
    <div class="me-card me-stack-panel">
      <div class="me-card-header">
        <span class="me-card-title">Caretaker Stack</span>
        <span class="me-badge badge-purple">@EditorService.UndoCount blok</span>
      </div>

      <div class="me-stack-container">
        @if (!EditorService.UndoHistory.Any())
        {
          <div class="me-empty">
            <div class="me-empty-icon">&#9633;</div>
            <p>Stack boş</p>
          </div>
        }
        else
        {
          @foreach (var item in EditorService.UndoHistory.Take(8).Select((m, i) => new { m, i }))
          {
            var isTop = item.i == 0;
            var size  = EditorService.Mode == SaveMode.Snapshot
                          ? item.m.SnapshotBytes : item.m.DeltaBytes;
            <div class="me-stack-block @(isTop ? "block-top" : "") @(_newTop && isTop ? "block-enter" : "")">
              <div class="me-block-row">
                <span class="me-block-time">@item.m.CreatedAt.ToString("HH:mm:ss")</span>
                @if (isTop)
                {
                  <span class="me-block-badge">TOP</span>
                }
              </div>
              <div class="me-block-preview">@item.m.Preview</div>
              <div class="me-block-size">@size bytes</div>
            </div>
          }

          @if (EditorService.UndoCount > 8)
          {
            <div class="me-stack-more">+ @(EditorService.UndoCount - 8) blok daha…</div>
          }
        }
      </div>

      <div class="me-stack-legend">
        <span>&#8593; Push (yeni kayıt)</span>
        <span>&#8595; Pop (Undo)</span>
      </div>
    </div>

    <!-- ── SAĞ: Geçmiş + Export/Import ─────────────────────────── -->
    <div class="me-card me-history-panel">
      <div class="me-card-header">
        <span class="me-card-title">Gecmis</span>
        <div class="me-io-btns">
          <button class="me-btn-sm btn-export" @onclick="ShowExport">Export</button>
          <button class="me-btn-sm btn-import" @onclick="ShowImport">Import</button>
        </div>
      </div>

      @if (!EditorService.UndoHistory.Any())
      {
        <div class="me-empty">
          <p>Henüz geçmiş yok</p>
        </div>
      }
      else
      {
        <ul class="me-hist-list">
          @foreach (var m in EditorService.UndoHistory.Take(25))
          {
            var snap  = m.SnapshotBytes;
            var delta = m.DeltaBytes;
            var pct   = snap > 0 ? (int)((delta / (float)snap) * 100) : 100;
            <li class="me-hist-item">
              <div class="me-hist-row">
                <span class="me-hist-time">@m.CreatedAt.ToString("HH:mm:ss")</span>
                <span class="me-hist-preview">@m.Preview</span>
              </div>
              <div class="me-hist-sizes">
                <span class="size-snap">S: @snap B</span>
                <span class="size-delta">D: @delta B</span>
                <span class="size-pct @(pct < 60 ? "pct-good" : "pct-bad")">@pct%</span>
              </div>
            </li>
          }
        </ul>
      }
    </div>

  </div>

  <!-- ══ EXPORT MODAL ════════════════════════════════════════════ -->
  @if (_showExport)
  {
    <div class="me-overlay" @onclick="CloseModals">
      <div class="me-modal" @onclick:stopPropagation>
        <div class="me-modal-header">
          <span>Export — JSON</span>
          <button class="me-modal-close" @onclick="CloseModals">X</button>
        </div>
        <p class="me-modal-hint">Aşağıdaki JSON'u kopyalayın, Import ile geri yükleyebilirsiniz.</p>
        <textarea class="me-modal-ta" readonly>@_exportJson</textarea>
        <button class="me-btn btn-export-copy" @onclick="CopyExport">Panoya Kopyala</button>
        @if (_copied)
        {
          <span class="me-copied-msg">Kopyalandi!</span>
        }
      </div>
    </div>
  }

  <!-- ══ IMPORT MODAL ════════════════════════════════════════════ -->
  @if (_showImport)
  {
    <div class="me-overlay" @onclick="CloseModals">
      <div class="me-modal" @onclick:stopPropagation>
        <div class="me-modal-header">
          <span>Import — JSON</span>
          <button class="me-modal-close" @onclick="CloseModals">X</button>
        </div>
        <p class="me-modal-hint">Export ettiğiniz JSON'u buraya yapıştırın.</p>
        <textarea class="me-modal-ta" @bind="_importJson" placeholder="JSON buraya..."></textarea>
        <div class="me-modal-actions">
          <button class="me-btn btn-import-go" @onclick="DoImport">Yukle</button>
          @if (_importError)
          {
            <span class="me-error-msg">Gecersiz JSON</span>
          }
          @if (_importOk)
          {
            <span class="me-copied-msg">Yuklendi!</span>
          }
        </div>
      </div>
    </div>
  }

</div>

<style>
  .me-root {
    max-width: 1200px;
    margin: 1.5rem auto;
    padding: 0 1rem;
    font-family: 'Segoe UI', system-ui, sans-serif;
  }
  .me-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    gap: .75rem;
  }
  .me-title-block { display: flex; align-items: center; gap: .75rem; }
  .me-logo { font-size: 1.8rem; color: #6366f1; }
  .me-title { font-size: 1.4rem; font-weight: 700; color: #1e293b; margin: 0; }
  .me-sub { font-size: .8rem; color: #64748b; margin: .1rem 0 0; }

  .me-mode-group { display: flex; background: #f1f5f9; border-radius: 8px; padding: 3px; gap: 3px; }
  .me-mode-btn {
    padding: .35rem .9rem; border: none; border-radius: 6px;
    font-size: .82rem; font-weight: 500; cursor: pointer;
    background: transparent; color: #64748b; transition: all .15s;
  }
  .me-mode-btn.active { background: #fff; color: #1e293b; box-shadow: 0 1px 3px rgba(0,0,0,.1); }

  .me-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 1rem;
  }
  .me-card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 1px 3px rgba(0,0,0,.05);
    display: flex;
    flex-direction: column;
  }
  .me-card-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: .6rem 1rem;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    font-size: .82rem;
  }
  .me-card-title { font-weight: 600; color: #475569; }

  .me-badge { padding: .12rem .55rem; border-radius: 999px; font-size: .72rem; font-weight: 500; }
  .badge-blue   { background: #dbeafe; color: #1d4ed8; }
  .badge-green  { background: #dcfce7; color: #15803d; }
  .badge-purple { background: #ede9fe; color: #6d28d9; }

  .me-textarea {
    width: 100%; box-sizing: border-box;
    padding: .9rem 1rem; border: none; outline: none;
    resize: vertical; font-size: .95rem; line-height: 1.65;
    color: #1e293b; background: #fff; font-family: inherit; flex: 1;
  }
  .me-toolbar {
    display: flex; gap: .45rem; padding: .6rem .9rem;
    border-top: 1px solid #e2e8f0; background: #f8fafc; flex-wrap: wrap;
  }
  .me-btn {
    padding: .38rem .85rem; border: none; border-radius: 7px;
    font-size: .82rem; font-weight: 500; cursor: pointer;
    transition: opacity .15s, transform .1s;
  }
  .me-btn:disabled { opacity: .38; cursor: not-allowed; }
  .me-btn:not(:disabled):hover { transform: translateY(-1px); }
  .btn-undo  { background: #dbeafe; color: #1d4ed8; }
  .btn-redo  { background: #dcfce7; color: #15803d; }
  .btn-clear { background: #fee2e2; color: #dc2626; }
  .ms-auto   { margin-left: auto; }

  .me-mem-bar {
    display: flex; align-items: center;
    padding: .5rem 1rem; gap: .6rem;
    border-top: 1px solid #e2e8f0; background: #fafafa; font-size: .75rem;
  }
  .me-mem-item  { display: flex; flex-direction: column; gap: .1rem; }
  .me-mem-label { color: #94a3b8; }
  .me-mem-val   { font-weight: 600; font-family: monospace; }
  .me-mem-val.blue  { color: #2563eb; }
  .me-mem-val.green { color: #16a34a; }
  .me-mem-val.amber { color: #d97706; }
  .me-mem-val.muted { color: #94a3b8; }
  .me-mem-divider   { width: 1px; height: 28px; background: #e2e8f0; }

  .me-stack-container {
    flex: 1; padding: .75rem; overflow-y: auto;
    display: flex; flex-direction: column; gap: .45rem;
  }
  .me-stack-block {
    border-radius: 8px; padding: .5rem .7rem;
    background: #f8fafc; border: 1px solid #e2e8f0; transition: all .2s;
  }
  .me-stack-block.block-top { background: #ede9fe; border-color: #a78bfa; }

  @@keyframes blockEnter {
    from { transform: translateY(-12px); opacity: 0; }
    to   { transform: translateY(0);     opacity: 1; }
  }
  .me-stack-block.block-enter { animation: blockEnter .25s ease-out; }

  .me-block-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: .2rem; }
  .me-block-time    { font-size: .7rem; color: #94a3b8; font-family: monospace; }
  .me-block-badge   { font-size: .65rem; background: #6d28d9; color: #fff; padding: .1rem .4rem; border-radius: 4px; }
  .me-block-preview { font-size: .78rem; color: #334155; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .me-block-size    { font-size: .7rem; color: #64748b; margin-top: .15rem; font-family: monospace; }
  .me-stack-more    { text-align: center; font-size: .75rem; color: #94a3b8; padding: .4rem 0; }
  .me-stack-legend  {
    display: flex; justify-content: space-between;
    padding: .45rem .9rem; border-top: 1px solid #e2e8f0;
    font-size: .72rem; color: #94a3b8; background: #f8fafc;
  }

  .me-hist-list { list-style: none; margin: 0; padding: .4rem; overflow-y: auto; max-height: 480px; }
  .me-hist-item { padding: .4rem .55rem; border-radius: 7px; margin-bottom: .2rem; transition: background .1s; }
  .me-hist-item:hover { background: #f1f5f9; }
  .me-hist-row  { display: flex; gap: .5rem; align-items: baseline; margin-bottom: .15rem; }
  .me-hist-time { font-size: .68rem; color: #94a3b8; font-family: monospace; flex-shrink: 0; }
  .me-hist-preview { font-size: .78rem; color: #334155; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .me-hist-sizes { display: flex; gap: .5rem; }
  .size-snap  { font-size: .68rem; color: #2563eb; font-family: monospace; }
  .size-delta { font-size: .68rem; color: #16a34a; font-family: monospace; }
  .size-pct   { font-size: .68rem; font-family: monospace; font-weight: 600; }
  .pct-good   { color: #16a34a; }
  .pct-bad    { color: #dc2626; }

  .me-io-btns { display: flex; gap: .3rem; }
  .me-btn-sm { padding: .22rem .6rem; border: none; border-radius: 5px; font-size: .73rem; font-weight: 500; cursor: pointer; }
  .btn-export { background: #dbeafe; color: #1d4ed8; }
  .btn-import { background: #dcfce7; color: #15803d; }

  .me-empty {
    display: flex; flex-direction: column; align-items: center;
    justify-content: center; flex: 1; padding: 2rem;
    color: #94a3b8; text-align: center; font-size: .85rem;
  }
  .me-empty-icon { font-size: 1.8rem; margin-bottom: .5rem; }

  .me-overlay {
    position: fixed; inset: 0; background: rgba(15,23,42,.45);
    display: flex; align-items: center; justify-content: center; z-index: 999;
  }
  .me-modal {
    background: #fff; border-radius: 14px; padding: 1.5rem;
    width: 540px; max-width: 90vw;
    box-shadow: 0 20px 60px rgba(0,0,0,.2);
    display: flex; flex-direction: column; gap: .75rem;
  }
  .me-modal-header { display: flex; justify-content: space-between; align-items: center; font-weight: 600; font-size: 1rem; color: #1e293b; }
  .me-modal-close  { background: none; border: none; font-size: 1rem; cursor: pointer; color: #64748b; padding: .2rem .4rem; }
  .me-modal-hint   { font-size: .82rem; color: #64748b; margin: 0; }
  .me-modal-ta     { width: 100%; height: 220px; box-sizing: border-box; padding: .6rem; font-family: monospace; font-size: .78rem; border: 1px solid #e2e8f0; border-radius: 8px; resize: vertical; outline: none; }
  .me-modal-actions { display: flex; align-items: center; gap: .75rem; }
  .btn-export-copy { background: #dbeafe; color: #1d4ed8; }
  .btn-import-go   { background: #dcfce7; color: #15803d; }
  .me-copied-msg   { font-size: .8rem; color: #16a34a; font-weight: 500; }
  .me-error-msg    { font-size: .8rem; color: #dc2626; font-weight: 500; }

  @@media (max-width: 900px) {
    .me-grid { grid-template-columns: 1fr; }
  }
</style>

@code {
    private string _content     = string.Empty;
    private bool   _newTop      = false;
    private bool   _showExport  = false;
    private bool   _showImport  = false;
    private bool   _copied      = false;
    private bool   _importError = false;
    private bool   _importOk    = false;
    private string _exportJson  = string.Empty;
    private string _importJson  = string.Empty;

    private double Savings
    {
        get
        {
            var snap  = EditorService.TotalSnapshotBytes;
            var delta = EditorService.TotalDeltaBytes;
            return snap > 0 ? (1 - delta / (double)snap) * 100 : 0;
        }
    }

    private async Task HandleInput(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? string.Empty;
        EditorService.UpdateContent(val);
        _content = EditorService.Content;
        _newTop  = true;
        StateHasChanged();
        await Task.Delay(300);
        _newTop = false;
        StateHasChanged();
    }

    private void Undo()  { EditorService.Undo();  _content = EditorService.Content; }
    private void Redo()  { EditorService.Redo();  _content = EditorService.Content; }
    private void Clear() { EditorService.Clear(); _content = string.Empty; }

    private void SetMode(SaveMode m) => EditorService.SetMode(m);

    private void ShowExport()
    {
        _exportJson = EditorService.ExportJson();
        _showExport = true;
        _copied     = false;
    }

    private void ShowImport()
    {
        _importJson  = string.Empty;
        _importError = false;
        _importOk    = false;
        _showImport  = true;
    }

    private void CloseModals() { _showExport = false; _showImport = false; }

    private async Task CopyExport()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }

    private void DoImport()
    {
        _importError = false;
        _importOk    = false;
        var ok = EditorService.ImportJson(_importJson);
        if (ok) { _content = EditorService.Content; _importOk = true; }
        else    { _importError = true; }
    }

    private static string FormatBytes(int b) =>
        b < 1024           ? $"{b} B"
        : b < 1024 * 1024  ? $"{b / 1024.0:F1} KB"
        :                    $"{b / (1024.0 * 1024):F2} MB";
}
